# Application
NODE_ENV=development
PORT=
API_PREFIX=

# Database (PostgreSQL - Raw SQL)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=
DB_IDLE_TIMEOUT=
DB_CONNECTION_TIMEOUT=

# JWT Config
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=1d
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Basic Auth
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox
PLATFORM_FEE_PERCENT=2

# App URL (untuk callback Midtrans)
APP_URL=https://ecommerce-backend.irfnbgs.my.id
FRONTEND_URL=https://ecommerce-clone-tokped.irfnbgs.my.id
CORS_ORIGINS=https://ecommerce-clone-tokped.irfnbgs.my.id,http://localhost:3001,http://127.0.0.1:3001

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecommerce
