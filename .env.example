# Application
NODE_ENV=development
PORT=
API_PREFIX=

# Database (PostgreSQL - Raw SQL)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=
DB_IDLE_TIMEOUT=
DB_CONNECTION_TIMEOUT=

# JWT Config
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=1d
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Basic Auth
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
